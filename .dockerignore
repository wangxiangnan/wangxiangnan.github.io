# .dockerignore —— Node.js 项目的典型配置

# 依赖目录（会在容器内重新安装）
node_modules
npm-debug.log*

# 版本控制
.git
.gitignore

# IDE 配置
.vscode
.idea

# 环境变量文件（安全！）
.env
.env.local

# Docker 相关文件
Dockerfile*
docker-compose*.yml
.dockerignore

# 文档
README.md
docs/

# 测试文件
__tests__/
*.test.js
coverage/

# 构建产物
dist/
build/

# 操作系统文件
.DS_Store