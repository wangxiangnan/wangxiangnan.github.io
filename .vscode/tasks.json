{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start dev",
      "type": "shell",
      "command": "npm run docs:dev",
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "docs:dev"
          },
          "endsPattern": {
            "regexp": "Local:|ERROR"
          }
        }
      },
      "isBackground": true
    }
  ]
}
